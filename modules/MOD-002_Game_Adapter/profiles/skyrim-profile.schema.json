{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-engine.local/schemas/skyrim-profile.schema.json",
  "title": "World Engine Skyrim SE AE Game Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "game_id",
    "adapter_id",
    "adapter_version",
    "support_status",
    "runtime_targets",
    "excluded_targets",
    "required_capabilities",
    "optional_capabilities",
    "known_limitations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "game_id": { "const": "skyrim-se-ae" },
    "adapter_id": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "support_status": {
      "enum": ["prototype", "partially_supported", "supported", "unsupported", "incompatible_environment"]
    },
    "runtime_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distribution", "edition", "runtime_version", "skse_version", "validation"],
        "properties": {
          "distribution": { "enum": ["steam", "gog"] },
          "edition": { "enum": ["anniversary", "special_legacy"] },
          "runtime_version": { "type": "string", "minLength": 1 },
          "skse_version": { "type": "string", "minLength": 1 },
          "validation": { "enum": ["pending_game_test", "validated", "failed"] }
        }
      }
    },
    "excluded_targets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "optional_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "known_limitations": { "type": "array", "items": { "type": "string" } }
  }
}
